# ==============================================================================
# NEXORA GROUP — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit secret keys.
# ==============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrator Security (Must be set to a strong secret in production)
ADMIN_SECRET_KEY=nexora-admin-secure-key-change-in-production

# Supabase Configuration (Optional for initial local run; required for cloud Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Video Generation Provider Configuration
# Supported providers: "luma" | "fal" | "replicate" | "mock"
VIDEO_PROVIDER=luma

# Luma Dream Machine API (https://lumalabs.ai/dream-machine/api)
LUMA_API_KEY=

# Fal.ai API (https://fal.ai)
FAL_KEY=

# Replicate API (https://replicate.com)
REPLICATE_API_TOKEN=

# Generation Safety Limits
VIDEO_MAX_CONCURRENT_JOBS=3
VIDEO_RATE_LIMIT_PER_HOUR=10

# Contact Form / Notification Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@nexoragroup.com
CONTACT_NOTIFICATION_EMAIL=contact@nexoragroup.com
